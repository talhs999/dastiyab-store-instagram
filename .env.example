# LLM — Gemini via its OpenAI-compatible endpoint (no fine-tuning; system prompt + catalog is enough)
# Get a key free at https://aistudio.google.com/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=AIza...
LLM_MODEL=gemini-2.0-flash
# (Any OpenAI-compatible API works — just point LLM_BASE_URL at it and set LLM_MODEL.)

# WhatsApp via Baileys (NO api key — QR pairing, NOT "Bellys")
# 1) npm run wa:login → scan the QR with the owner's WhatsApp
#    (or scan the QR on the dashboard's WhatsApp card)
# 2) For Vercel production: paste the WA_CREDS_JSON printed by wa:login
#    (/tmp is ephemeral on Vercel, so creds must come from env)
# WA_CREDS_JSON=<base64 from npm run wa:login>
OWNER_WHATSAPP=923162975195

# Meta session-based DM access (NO App ID — owner login, cookies pasted)
IG_USERNAME=
IG_PASSWORD=
IG_COOKIES=
FB_USERNAME=
FB_PASSWORD=
FB_COOKIES=

# Cron security (Vercel sends this automatically for cron jobs; set the same value in Vercel env)
CRON_SECRET=change-me-to-a-long-random-string

# Writable data dir (conversations, orders, synced catalog). On Vercel this is ephemeral /tmp.
DATA_DIR=/tmp/dastiyab-agent
